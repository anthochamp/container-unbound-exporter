{
	"private": true,
	"description": "Unbound Exporter container exposing DNS resolver statistics as Prometheus metrics",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"type": "module",
	"scripts": {
		"test": "node --import=tsx --test-concurrency 1 --test tests/**/*.test.*",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"lint": "oxlint && markdownlint-cli2",
		"lint:fix": "oxlint --fix && markdownlint-cli2 --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"postinstall": "is-ci || lefthook install"
	},
	"devDependencies": {
		"@ac-kit/markdownlint-cli2-config": "0.2.0",
		"@ac-kit/oxlint-config": "0.2.0",
		"@ac-kit/tsconfig": "0.1.0",
		"@ac-kit/vitest-config": "0.1.1",
		"@types/node": "24.19.0",
		"is-ci": "4.1.0",
		"lefthook": "2.1.15",
		"markdownlint-cli2": "0.23.3",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.2"
	}
}
